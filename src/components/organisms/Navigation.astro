---
import Brand from "@components/atoms/Brand.astro";
import ModeToggle from "@components/atoms/ModeToggle";
import NavLinks from "@components/atoms/NavLinks.astro";
import MobileNav from "@components/organisms/MobileNav";
interface Props {
  between?: boolean;
}

const { between = false } = Astro.props;
---

<nav class="flex items-center justify-between p-4">
  <MobileNav client:load />
  <div class="hidden md:flex">
    <Brand label="Brand" tagline="Solucion al alcance de ti." />
  </div>
  <div class="hidden md:flex">
    <NavLinks />
  </div>
  <div>
    <ModeToggle client:visible />
  </div>
</nav>
