---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="flex flex-col items-center text-center p-6 rounded-lg shadow-sm bg-card text-card-foreground h-full">
  <div class="mb-4 text-primary">
    <slot name="icon" />
  </div>
  <h3 class="text-xl font-semibold mb-2">{title}</h3>
  <p class="text-muted-foreground text-balance">{description}</p>
</div>