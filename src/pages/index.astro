---
import { TitleSection } from "@/components";
import IconWrapper from "@/components/atoms/IconWrapper";
import FeatureCard from "@/components/molecules/FeatureCard.astro";
import Mosaic from "@/components/molecules/Mosaic.astro";
import Hero from "@/components/organisms/hero/Hero1.astro";
import Hero2 from "@/components/organisms/hero/Hero2.astro";
import Hero3 from "@/components/organisms/hero/Hero3.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <Hero3
    badge="✨ Tu Librería de Componentes"
    title="Componentes Modernos para Astro, React y Más"
    subtitle="Descubre una colección versátil de componentes UI listos para usar, diseñados para integrarse perfectamente en tus proyectos Astro, React, y otras tecnologías web."
    buttons={{
      primary: {
        text: "Explorar Componentes",
        url: "/components",
      },
      secondary: {
        text: "Ver en GitHub",
        url: "https://www.github.com/",
      },
    }}
  />

  <Hero2
    badge="🚀 Integración Flexible"
    title="Diseñados para la Compatibilidad"
    subtitle="Nuestros componentes están construidos con tecnologías modernas como Tailwind CSS y Radix UI, asegurando una integración fluida y un rendimiento óptimo en cualquier stack."
    buttons={{
      primary: {
        text: "Ver Documentación",
        url: "/docs",
      },
      secondary: {
        text: "Comunidad",
        url: "https://discord.com/",
      },
    }}
    image={{
      src: "https://www.shadcnblocks.com/images/block/placeholder-1.svg",
      alt: "Hero section demo image showing interface components",
    }}
  />
  <Hero
    badge="💡 Fácil de Usar"
    title="Copia, Pega y Personaliza"
    subtitle="Obtén componentes de alta calidad con solo copiar y pegar el código. Totalmente personalizables para adaptarse a la identidad visual de tu proyecto."
  />

  <section class="container mx-auto px-4 py-12">
    <TitleSection
      title="Características Principales"
      subtitle="Lo que hace a nuestra librería la elección perfecta para tus proyectos."
      align="center"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
      <FeatureCard
        title="Multi-Framework"
        description="Componentes compatibles con Astro, React, y más, para una flexibilidad sin precedentes."
      >
        <Fragment slot="icon">
          <IconWrapper client:load name="Layers" size={48} />
        </Fragment>
      </FeatureCard>
      <FeatureCard
        title="Totalmente Personalizable"
        description="Adapta cada componente a la identidad de tu marca con facilidad, gracias a Tailwind CSS."
      >
        <Fragment slot="icon">
          <IconWrapper client:load name="Palette" size={48} />
        </Fragment>
      </FeatureCard>
      <FeatureCard
        title="Rendimiento Optimizado"
        description="Construidos para la velocidad, nuestros componentes aseguran una experiencia de usuario fluida y rápida."
      >
        <Fragment slot="icon">
          <IconWrapper client:load name="Zap" size={48} />
        </Fragment>
      </FeatureCard>
      <FeatureCard
        title="Accesibilidad Primero"
        description="Diseñados siguiendo las mejores prácticas de accesibilidad para una experiencia inclusiva."
      >
        <Fragment slot="icon">
          <IconWrapper client:load name="Accessibility" size={48} />
        </Fragment>
      </FeatureCard>
      <FeatureCard
        title="Documentación Clara"
        description="Guías detalladas y ejemplos de código para que empieces a construir en minutos."
      >
        <Fragment slot="icon">
          <IconWrapper client:load name="BookOpen" size={48} />
        </Fragment>
      </FeatureCard>
      <FeatureCard
        title="Comunidad Activa"
        description="Únete a nuestra comunidad para soporte, ideas y colaboración."
      >
        <Fragment slot="icon">
          <IconWrapper client:load name="Users" size={48} />
        </Fragment>
      </FeatureCard>
    </div>
  </section>

  <section class="container mx-auto px-4 py-12">
    <TitleSection
      title="Nuestros Componentes en Acción"
      subtitle="Explora la belleza y funcionalidad de nuestra librería a través de ejemplos visuales."
      align="center"
    />
    <div class="mt-12">
      <Mosaic
        images={[
          {
            src: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
            alt: "Componente de código",
          },
          {
            src: "https://images.unsplash.com/photo-1542831371-29b0f74f9713?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
            alt: "Interfaz de usuario",
          },
          {
            src: "https://images.unsplash.com/photo-1550439062-609e1d365d99?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
            alt: "Diseño responsivo",
          },
          {
            src: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
            alt: "Componente de código",
          },
          {
            src: "https://images.unsplash.com/photo-1542831371-29b0f74f9713?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
            alt: "Interfaz de usuario",
          },
          {
            src: "https://images.unsplash.com/photo-1550439062-609e1d365d99?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
            alt: "Diseño responsivo",
          },
          {
            src: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
            alt: "Componente de código",
          },
          {
            src: "https://images.unsplash.com/photo-1542831371-29b0f74f9713?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
            alt: "Interfaz de usuario",
          },
          {
            src: "https://images.unsplash.com/photo-1550439062-609e1d365d99?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
            alt: "Diseño responsivo",
          },
        ]}
      />
    </div>
  </section>

  <section class="container mx-auto px-4 py-12 text-center">
    <TitleSection
      title="¿Listo para Construir Algo Increíble?"
      subtitle="Empieza hoy mismo con nuestra librería de componentes y lleva tus proyectos al siguiente nivel."
      align="center"
    />
    <div class="mt-8 flex justify-center gap-4">
      <a
        href="/components"
        class="bg-primary text-primary-foreground px-6 py-3 rounded-md text-lg font-semibold hover:bg-primary/90 transition-colors"
      >
        Explorar Componentes
      </a>
      <a
        href="https://github.com/"
        class="border border-input bg-background px-6 py-3 rounded-md text-lg font-semibold hover:bg-accent hover:text-accent-foreground transition-colors"
      >
        Ver en GitHub
      </a>
    </div>
  </section>
</Layout>
